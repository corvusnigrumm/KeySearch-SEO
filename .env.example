# ── KeySearch V10.0 Ultra - Variables de Entorno ──
# Copia este archivo como .env y rellena tus valores.

# ── JWT / Seguridad ──
# Genera un valor aleatorio largo, ej: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── Base de Datos (opcional, usa SQLite local si no se define) ──
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── IA / LLM ──
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Opcionales (si usas OpenAI directo):
# OPENAI_API_KEY=

# ── Google Ads API (opcional) ──
# GOOGLE_ADS_CUSTOMER_ID=1234567890

# ── Scraping ──
# SCRAPE_PROFILE=normal
# HTTP_CACHE_TTL_SECONDS=86400
# SERP_MIN_REQUEST_INTERVAL_MIN=4.0
# SERP_MIN_REQUEST_INTERVAL_MAX=8.0
# SERP_429_BREAKER_THRESHOLD=2

# ── Render / Deploy ──
# PORT=8000
